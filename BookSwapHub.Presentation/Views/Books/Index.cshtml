@model IEnumerable<BookSwapHub.Application.Models.BookDto>
@using Microsoft.AspNetCore.Identity
@using BookSwapHub.Infrastructure.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = "Books";
    var uid = UserManager.GetUserId(User);
}
<section class="hero p-4 p-md-5 mb-4">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
        <div>
            <h1 class="display-6 fw-bold mb-1">Discover, Post, and Swap Books</h1>
            <p class="small-muted mb-0">List your books, request trades, and grow your library with the community.</p>
        </div>
        @if (SignInManager.IsSignedIn(User))
        {
            <div class="d-flex gap-2">
                <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i> Post a Book</a>
                <a class="btn btn-outline-secondary" asp-action="Mine"><i class="bi bi-person-lines-fill"></i> My Books</a>
            </div>
        }
    </div>
</section>
<form method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-6">
        <input name="q" class="form-control" placeholder="Search by title or author" value="@Context.Request.Query["q"]" />
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i> Search</button>
    </div>
</form>
@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-book"></i>
        <h3 class="mt-3">No books found</h3>
        <p>There are no books available at the moment. @(SignInManager.IsSignedIn(User) ? "Be the first to post one!" : "Sign in to post your first book!")</p>
        @if (SignInManager.IsSignedIn(User))
        {
            <a class="btn btn-primary mt-2" asp-action="Create"><i class="bi bi-plus-lg"></i> Post a Book</a>
        }
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    @foreach (var b in Model)
    {
        <div class="col">
            <div class="card h-100 shadow-sm book-card">
                @if (!string.IsNullOrWhiteSpace(b.ImagePath))
                {
                    <img src="@b.ImagePath" class="book-cover card-img-top" alt="@b.Title cover" />
                }
                else
                {
                    <div class="book-cover card-img-top bg-light d-flex align-items-center justify-content-center">
                        <i class="bi bi-book display-4 text-secondary"></i>
                    </div>
                }
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title mb-1">
                        <a asp-action="Details" asp-route-id="@b.Id" class="text-decoration-none stretched-link">@b.Title</a>
                    </h5>
                    <div class="small-muted mb-2"><i class="bi bi-pen"></i> @b.Author</div>
                    @if (!string.IsNullOrWhiteSpace(b.Category))
                    {
                        <div class="mb-2"><span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-tag"></i> @b.Category</span></div>
                    }
                    <p class="card-text flex-grow-1 small">@(b.Description?.Length > 100 ? b.Description.Substring(0, 100) + "..." : b.Description)</p>
                    <div class="mt-auto">
                        <small class="text-muted"><i class="bi bi-clock"></i> Posted @b.CreatedAt.ToString("MMM dd, yyyy")</small>
                    </div>
                </div>
                <div class="card-footer d-flex justify-content-between align-items-center bg-white border-top">
                    <span class="badge text-bg-light"><i class="bi bi-person"></i> @(!string.IsNullOrWhiteSpace(b.OwnerName) ? b.OwnerName : "Unknown")</span>
                    <div class="d-flex gap-2" style="position: relative; z-index: 10;">
                    @if (SignInManager.IsSignedIn(User) && uid != b.OwnerId)
                    {
                        <a class="btn btn-sm btn-success" asp-controller="Swaps" asp-action="Create" asp-route-toBookId="@b.Id" asp-route-toUserId="@b.OwnerId" style="position: relative;"><i class="bi bi-arrow-left-right"></i> Swap</a>
                    }
                    @if (SignInManager.IsSignedIn(User) && uid == b.OwnerId)
                    {
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id" style="position: relative;"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" method="post" class="m-0" style="position: relative;" onsubmit="return confirm('Are you sure you want to delete this book?');">
                            <input type="hidden" name="id" value="@b.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                        </form>
                    }
                    </div>
                </div>
            </div>
        </div>
    }
    </div>
}
