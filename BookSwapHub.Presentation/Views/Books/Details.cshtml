@model BookSwapHub.Application.Models.BookDto
@using Microsoft.AspNetCore.Identity
@using BookSwapHub.Infrastructure.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    ViewData["Title"] = Model.Title;
    var uid = UserManager.GetUserId(User);
}
<nav aria-label="breadcrumb" class="mb-3">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="Index">Books</a></li>
    <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
  </ol>
</nav>

<div class="row g-4">
  <div class="col-lg-4">
    <div class="card shadow-sm sticky-top" style="top: 20px;">
      <div class="ratio ratio-3x4">
        <img src="@(string.IsNullOrWhiteSpace(Model.ImagePath) ? "https://placehold.co/600x800?text=No+Image" : Model.ImagePath)" class="card-img-top object-fit-cover" alt="Book cover" />
      </div>
      <div class="card-body">
        @if (!string.IsNullOrWhiteSpace(Model.Category))
        {
          <div class="mb-2"><span class="badge bg-info-subtle text-info-emphasis"><i class="bi bi-tag"></i> @Model.Category</span></div>
        }
        <div class="mb-2"><i class="bi bi-box-seam"></i> Condition: <strong class="text-success">@Model.Condition</strong></div>
        <div class="small text-muted"><i class="bi bi-clock"></i> Posted @Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
      </div>
      <div class="card-footer bg-white">
        <div class="d-grid gap-2">
          @if (SignInManager.IsSignedIn(User) && uid != Model.OwnerId)
          {
            <a class="btn btn-success btn-lg" asp-controller="Swaps" asp-action="Create" asp-route-toBookId="@Model.Id" asp-route-toUserId="@Model.OwnerId"><i class="bi bi-arrow-left-right"></i> Request Swap</a>
          }
          @if (SignInManager.IsSignedIn(User) && uid == Model.OwnerId)
          {
            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil-square"></i> Edit Book</a>
            <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this book?');">
                <input type="hidden" name="id" value="@Model.Id" />
                <button class="btn btn-outline-danger w-100"><i class="bi bi-trash"></i> Delete Book</button>
            </form>
          }
        </div>
      </div>
    </div>
  </div>
  <div class="col-lg-8">
    <div class="card shadow-sm mb-3">
      <div class="card-body">
        <h1 class="h2 mb-2">@Model.Title</h1>
        <div class="mb-3 text-muted"><i class="bi bi-pen"></i> by <strong>@Model.Author</strong></div>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
          <h5 class="mt-4 mb-2">Description</h5>
          <p class="lead">@Model.Description</p>
        }
        else
        {
          <p class="text-muted fst-italic">No description available.</p>
        }
      </div>
    </div>
    
    <div class="card shadow-sm">
      <div class="card-body">
        <h5 class="card-title mb-3"><i class="bi bi-person-circle"></i> Book Owner</h5>
        <div class="d-flex align-items-center gap-3">
          <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.5rem;">
            <i class="bi bi-person"></i>
          </div>
          <div>
            <div class="fw-bold">@Model.OwnerName</div>
            <a asp-controller="Users" asp-action="Profile" asp-route-id="@Model.OwnerId" class="small text-decoration-none">View profile <i class="bi bi-arrow-right"></i></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
