@model IEnumerable<BookSwapHub.Application.Models.SwapRequestDto>
@{
    ViewData["Title"] = "Outgoing Swaps";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-send"></i> Outgoing Swap Requests</h2>
    <a asp-action="Incoming" class="btn btn-outline-primary"><i class="bi bi-inbox"></i> View Incoming</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-send"></i>
        <h3 class="mt-3">No outgoing swap requests</h3>
        <p>You haven't sent any swap requests yet. Browse books and request a swap!</p>
        <a class="btn btn-primary mt-2" asp-controller="Books" asp-action="Index"><i class="bi bi-collection"></i> Browse Books</a>
    </div>
}
else
{
    <div class="table-responsive-custom">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>To User</th>
                    <th>From Book (Your Book)</th>
                    <th>To Book (Their Book)</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><span class="badge text-bg-light"><i class="bi bi-person"></i> @r.ToUserId[..Math.Min(8, r.ToUserId.Length)]…</span></td>
                        <td>
                            <div><strong>@r.FromBookTitle</strong></div>
                            <div class="small text-muted"><i class="bi bi-pen"></i> @r.FromBookAuthor</div>
                        </td>
                        <td>
                            <div><strong>@r.ToBookTitle</strong></div>
                            <div class="small text-muted"><i class="bi bi-pen"></i> @r.ToBookAuthor</div>
                        </td>
                        <td>
                            @{
                                var statusClass = r.Status.ToString().ToLower();
                                var badgeClass = statusClass switch {
                                    "pending" => "status-pending",
                                    "accepted" => "status-accepted",
                                    "rejected" => "status-rejected",
                                    "completed" => "status-completed",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@r.Status</span>
                        </td>
                        <td class="text-end">
                            @if (r.Status == BookSwapHub.Application.Enums.SwapStatus.Pending)
                            {
                                <form asp-action="Cancel" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <button class="btn btn-sm btn-outline-warning" onclick="return confirm('Cancel this swap request?');"><i class="bi bi-x-circle"></i> Cancel</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">No actions available</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
