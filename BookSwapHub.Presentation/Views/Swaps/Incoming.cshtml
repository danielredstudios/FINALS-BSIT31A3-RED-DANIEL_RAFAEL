@model IEnumerable<BookSwapHub.Application.Models.SwapRequestDto>
@{
    ViewData["Title"] = "Incoming Swaps";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0"><i class="bi bi-inbox"></i> Incoming Swap Requests</h2>
    <a asp-action="Outgoing" class="btn btn-outline-primary"><i class="bi bi-send"></i> View Outgoing</a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <i class="bi bi-inbox"></i>
        <h3 class="mt-3">No incoming swap requests</h3>
        <p>You don't have any swap requests at the moment. Check back later!</p>
    </div>
}
else
{
    <div class="table-responsive-custom">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>From User</th>
                    <th>From Book</th>
                    <th>To Book</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td><span class="badge text-bg-light"><i class="bi bi-person"></i> @r.FromUserId[..Math.Min(8, r.FromUserId.Length)]…</span></td>
                        <td>
                            <div><strong>@r.FromBookTitle</strong></div>
                            <div class="small text-muted"><i class="bi bi-pen"></i> @r.FromBookAuthor</div>
                        </td>
                        <td>
                            <div><strong>@r.ToBookTitle</strong></div>
                            <div class="small text-muted"><i class="bi bi-pen"></i> @r.ToBookAuthor</div>
                        </td>
                        <td>
                            @{
                                var statusClass = r.Status.ToString().ToLower();
                                var badgeClass = statusClass switch {
                                    "pending" => "status-pending",
                                    "accepted" => "status-accepted",
                                    "rejected" => "status-rejected",
                                    "completed" => "status-completed",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@r.Status</span>
                        </td>
                        <td class="text-end">
                            @if (r.Status == BookSwapHub.Application.Enums.SwapStatus.Pending)
                            {
                                <form asp-action="Respond" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="decision" value="accept" />
                                    <button class="btn btn-sm btn-success" onclick="return confirm('Accept this swap request?');"><i class="bi bi-check-lg"></i> Accept</button>
                                </form>
                                <form asp-action="Respond" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="id" value="@r.Id" />
                                    <input type="hidden" name="decision" value="reject" />
                                    <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Reject this swap request?');"><i class="bi bi-x-lg"></i> Reject</button>
                                </form>
                            }
                            else
                            {
                                <span class="text-muted small">No actions available</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
