<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Book Swap Hub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-body-tertiary" data-authenticated="@(User.Identity?.IsAuthenticated == true ? "true" : "false")">
    <header class="border-bottom bg-body">
        <nav class="navbar navbar-expand-lg navbar-light container py-2">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book-half text-primary"></i> Book Swap Hub
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div id="mainNav" class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Books" asp-action="Index"><i class="bi bi-collection"></i> Books</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Books" asp-action="Mine"><i class="bi bi-person-lines-fill"></i> My Books</a></li>
                        <li class="nav-item"><a class="nav-link position-relative" asp-area="" asp-controller="Swaps" asp-action="Incoming"><i class="bi bi-bell"></i> Notifications <span class="badge bg-danger ms-1" id="notifBadge" style="display:none"></span></a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Swaps" asp-action="Outgoing"><i class="bi bi-send"></i> Outgoing</a></li>
                    }
                </ul>
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <button type="button" id="themeToggle" class="btn btn-outline-secondary btn-sm" title="Toggle theme">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4 min-vh-100">
        @if (TempData["Success"] is string sMsg)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill"></i> @sMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] is string eMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i> @eMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="border-top small py-3 bg-body">
        <div class="container d-flex justify-content-between align-items-center">
            <span>&copy; @DateTime.UtcNow.Year · Book Swap Hub</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
      // Theme toggle with persistence
      (function(){
        const key='theme';
        const html=document.documentElement;
        const apply=(t)=>html.setAttribute('data-bs-theme', t);
        const saved=localStorage.getItem(key);
        if(saved){ apply(saved); }
        document.getElementById('themeToggle')?.addEventListener('click',()=>{
          const cur=html.getAttribute('data-bs-theme')||'light';
          const next=cur==='light'?'dark':'light';
          apply(next);
          localStorage.setItem(key,next);
        });
      })();

      // Header notifications: query a lightweight endpoint when authenticated
      document.addEventListener('DOMContentLoaded', async () => {
        const authed = document.body.dataset.authenticated === 'true';
        if (!authed) return;
        try {
          const r = await fetch('/Swaps/CountPending', { headers: { 'Accept': 'application/json' } });
          if (!r.ok) return;
          const data = await r.json();
          if (data.pending > 0) {
            const b = document.getElementById('notifBadge');
            if (b) { b.style.display='inline-block'; b.textContent = data.pending; }
          }
        } catch {}
      });

      // Add show/hide toggle for password inputs that are not already grouped
      document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('input[type="password"]').forEach(inp => {
          if (inp.closest('.input-group') || inp.closest('.form-floating')) return;
          const wrap = document.createElement('div');
          wrap.className = 'input-group';
          const parent = inp.parentElement;
          if (!parent) return;
          parent.replaceChild(wrap, inp);
          wrap.appendChild(inp);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn btn-outline-secondary';
          btn.innerHTML = '<i class="bi bi-eye"></i>';
          btn.addEventListener('click', () => {
            const isPwd = inp.type === 'password';
            inp.type = isPwd ? 'text' : 'password';
            btn.innerHTML = isPwd ? '<i class="bi bi-eye-slash"></i>' : '<i class="bi bi-eye"></i>';
          });
          wrap.appendChild(btn);
        });
      });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
